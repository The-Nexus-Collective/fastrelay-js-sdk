  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "node --test 'test/*.test.ts'"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
